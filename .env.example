# Provider: openai
LLM_PROVIDER=kimi

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Kimi / Moonshot
KIMI_API_KEY=
KIMI_MODEL=kimi-k2

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# ChromaDB / RAG (mantidos conforme a configuração do projeto)
CHROMA_PERSIST_PATH=./chroma_data
CHROMA_COLLECTION_CWE=cwe_docs
CHROMA_COLLECTION_WSTG=wstg_docs
TOP_K_CWE=2
TOP_K_WSTG=2
